---
import { contact, localBusiness, siteMeta } from "../content/site";

const site = Astro.site!;

const schema = {
  "@context": "https://schema.org",
  "@type": localBusiness.type,
  "@id": localBusiness.id,
  name: siteMeta.name,
  description: siteMeta.description,
  url: site.href,
  image: new URL(siteMeta.ogImage, site).href,
  email: contact.email,
  priceRange: localBusiness.priceRange,
  currenciesAccepted: localBusiness.currency,
  address: {
    "@type": "PostalAddress",
    streetAddress: contact.addressLines.slice(0, -1).join(", "),
    postalCode: "08037",
    addressLocality: "Barcelona",
    addressRegion: "Barcelona",
    addressCountry: "ES",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: localBusiness.geo.latitude,
    longitude: localBusiness.geo.longitude,
  },
  sameAs: [contact.instagram.href],
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
