---
import BaseLayout from "../layouts/BaseLayout.astro";
import { contact, espacioCopy, images } from "../content/site";
---

<BaseLayout title={espacioCopy.pageTitle} description={espacioCopy.description}>
  <img class="space-hero" src={images.studioWide.src} alt="Adarsha Yoga" />
  <section class="space-main">
    <div class="container">
      <div class="space-copy">
        <h1>{espacioCopy.heading}</h1>
        {espacioCopy.body.map((item) => <p>{item}</p>)}
        <ul>{espacioCopy.uses.map((item) => <li>{item}</li>)}</ul>
        <p class="email">{espacioCopy.emailPrefix} <a href={`mailto:${contact.email}?subject=Alquiler sala`}>{contact.email}</a> {espacioCopy.emailSuffix}</p>
      </div>
      <div class="space-pair">
        <img src={images.studioShelf.src} alt="Material de yoga en Adarsha Yoga" />
        <img src={images.studioTall.src} alt="Luz natural en Adarsha Yoga" />
      </div>
    </div>
  </section>
  <section class="space-details">
    <div class="container space-details-inner">
      <img src={images.studioDetail.src} alt="Detalle del estudio" />
      <div>
        <h2>{espacioCopy.details.addressHeading}</h2><p>{espacioCopy.details.addressLines.map((line) => <>{line}<br /></>)}</p>
        <h2>{espacioCopy.details.contactHeading}</h2><p><a href={`mailto:${contact.email}`}>{contact.email}</a></p>
        <h2>{espacioCopy.details.visitsHeading}</h2>{espacioCopy.visits.map((item) => <p>{item}</p>)}
      </div>
    </div>
  </section>
</BaseLayout>
