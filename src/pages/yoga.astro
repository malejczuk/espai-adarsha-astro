---
import BaseLayout from "../layouts/BaseLayout.astro";
import { yogaCopy, images } from "../content/site";
---

<BaseLayout title={yogaCopy.pageTitle} description={yogaCopy.description}>
  <section class="yoga-title">
    <h1>{yogaCopy.introTitle}</h1>
    <p>{yogaCopy.introQuestion}</p>
  </section>

  {/* #metodo is the anchor the section this one replaced answered to; it
      stays so that links already pointing at it still land here. */}
  <section id="metodo" class="yoga-different">
    <div class="container">
      <div class="yoga-different-intro">
        <h2>{yogaCopy.differentTitle}</h2>
        {yogaCopy.differentIntro.map((para) => <p>{para}</p>)}
      </div>
      <div class="yoga-pillars">
        {yogaCopy.pillars.map((pillar) => (
          <article class="yoga-pillar">
            <h3>{pillar.title}</h3>
            {pillar.body.map((para) => <p>{para}</p>)}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="clases" class="yoga-rhythm">
    <div class="yoga-rhythm-copy">
      <h2>{yogaCopy.classesTitle}</h2>
      <div class="class-accordion">
        {/* Each style is its own heading and its own anchor, so /yoga/#yin-yoga
            lands on it and an outline of the page lists the five styles. The
            h3 inherits the summary's type, so nothing moves. */}
        {yogaCopy.classes.map((item) => (
          <details class="class-item" id={item.id}>
            <summary><h3>{item.title}</h3></summary>
            {(Array.isArray(item.body) ? item.body : [item.body]).map((para) => (
              <p>{para}</p>
            ))}
          </details>
        ))}
      </div>
    </div>
    <div class="yoga-photo-stack">
      <img src={images.groupClass.src} alt="Clase grupal de yoga en Adarsha Yoga, Barcelona" />
    </div>
  </section>

  <section id="mensualidad" class="membership-section">
    <div class="container membership-inner">
      <h2>{yogaCopy.membershipTitle}</h2>
      <ul class="membership-list">
        {yogaCopy.membership.map((item) => <li><strong>{item.title}:</strong> {item.body}</li>)}
      </ul>
      <p class="membership-cta"><a class="btn-outline" href={yogaCopy.membershipHref}>{yogaCopy.membershipCta}</a></p>
    </div>
  </section>

  <section id="individuales" class="individual-section">
    <div class="individual-copy">
      <h2>{yogaCopy.individualTitle}</h2>
      <p>{yogaCopy.individualIntro}</p>
      <ul class="individual-list">{yogaCopy.individualOptions.map((item) => <li><strong>{item.title}:</strong> {item.body}</li>)}</ul>
      <p>{yogaCopy.individualClosing}</p>
    </div>
    <img src={images.individualSession.src} alt="Clase individual adaptada" />
  </section>

  {/* #empresas was the full corporate section, which moved to /oficina/. The
      id stays for links already pointing at it. */}
  <section id="empresas" class="office-teaser">
    <h2>{yogaCopy.officeTeaserTitle}</h2>
    <p>{yogaCopy.officeTeaser}</p>
    <a class="btn-outline" href={yogaCopy.officeTeaserHref}>{yogaCopy.officeTeaserCta}</a>
  </section>
  <!-- A fragment link to a closed <details> scrolls to a shut drawer, so open
       the one that was asked for. Runs on load and on every later hash change,
       since the five styles link to each other within the page. -->
  <script is:inline>
    (() => {
      const open = () => {
        if (!location.hash) return;
        let item = null;
        try { item = document.querySelector(location.hash); } catch {}
        if (item instanceof HTMLDetailsElement) {
          item.open = true;
          item.scrollIntoView({ block: "start" });
        }
      };
      open();
      addEventListener("hashchange", open);
    })();
  </script>
</BaseLayout>
