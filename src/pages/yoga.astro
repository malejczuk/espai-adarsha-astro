---
import BaseLayout from "../layouts/BaseLayout.astro";
import { yogaCopy, images } from "../content/site";
---

<BaseLayout title={yogaCopy.pageTitle} description={yogaCopy.description}>
  <section class="yoga-title">
    <h1>{yogaCopy.introTitle}</h1>
    <p>{yogaCopy.introQuestion}</p>
  </section>

  <section class="yoga-rhythm">
    <div class="yoga-rhythm-copy">
      <h2>{yogaCopy.rhythmTitle}</h2>
      <p>{yogaCopy.intro}</p>
      <div class="class-accordion">
        {/* Each style is its own heading and its own anchor, so /yoga/#yin-yoga
            lands on it and an outline of the page lists the five styles. The
            h3 inherits the summary's type, so nothing moves. */}
        {yogaCopy.classes.map((item) => (
          <details class="class-item" id={item.id}>
            <summary><h3>{item.title}</h3></summary>
            {(Array.isArray(item.body) ? item.body : [item.body]).map((para) => (
              <p>{para}</p>
            ))}
          </details>
        ))}
      </div>
    </div>
    <div class="yoga-photo-stack">
      <img src={images.groupClass.src} alt="Clase grupal de yoga" />
    </div>
  </section>

  <section id="metodo" class="method-section">
    <div class="container method-inner">
      <img src={images.meditation.src} alt="Práctica progresiva de yoga" />
      <div>
        <h2>{yogaCopy.methodTitle}</h2>
        <ul class="method-list">{yogaCopy.method.map((item) => <li><strong>{item.title}:</strong> {item.body}</li>)}</ul>
      </div>
    </div>
  </section>

  <section id="individuales" class="individual-section">
    <div class="individual-copy">
      <h2>{yogaCopy.individualTitle}</h2>
      <p>{yogaCopy.individualIntro}</p>
      <ul class="individual-list">{yogaCopy.individualOptions.map((item) => <li><strong>{item.title}:</strong> {item.body}</li>)}</ul>
      <p>{yogaCopy.individualClosing}</p>
    </div>
    <img src={images.individualSession.src} alt="Clase individual adaptada" />
  </section>

  <section id="empresas" class="office-section">
    <img class="office-image" src={images.yogaOffice2.src} alt="Yoga para empresas" />
    <div class="office-copy">
      <h2>{yogaCopy.officeTitle}</h2>
      {yogaCopy.officeBody.map((item) => <p>{item}</p>)}
      <p><a href="/contacto/#contacto">{yogaCopy.officeCta}</a></p>
    </div>
  </section>
  <!-- A fragment link to a closed <details> scrolls to a shut drawer, so open
       the one that was asked for. Runs on load and on every later hash change,
       since the five styles link to each other within the page. -->
  <script is:inline>
    (() => {
      const open = () => {
        if (!location.hash) return;
        let item = null;
        try { item = document.querySelector(location.hash); } catch {}
        if (item instanceof HTMLDetailsElement) {
          item.open = true;
          item.scrollIntoView({ block: "start" });
        }
      };
      open();
      addEventListener("hashchange", open);
    })();
  </script>
</BaseLayout>
