---
import BaseLayout from "../layouts/BaseLayout.astro";
import { externalLinks, yogaCopy, images } from "../content/site";
---

<BaseLayout title={yogaCopy.pageTitle} description={yogaCopy.description}>
  <section class="yoga-title">
    <h1>{yogaCopy.introTitle}</h1>
  </section>

  {/* Laid out like the home intro: the photo fills the left half of the page
      edge to edge, the copy sits in the right half on clay. #metodo was the
      old "Un método basado en la progresión" block's anchor; it stays so that
      links already pointing at it still land here. */}
  <section id="metodo" class="method-section">
    <div class="method-inner">
      <img src={images.yogaPractice.src} alt="Práctica de yoga en la sala de Adarsha Yoga, Barcelona" />
      <div class="method-copy">
        {yogaCopy.pillars.map((pillar) => (
          <article class="method-pillar">
            <h2>{pillar.title}</h2>
            {pillar.body.map((para) => <p>{para}</p>)}
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* The question, just above the class list. Its own section, outside
      .yoga-rhythm, because the open style's photo is placed from the top of
      that one. The booking button that answers it closes the class list. */}
  <section class="yoga-question-band">
    <p class="yoga-question">{yogaCopy.introQuestion}</p>
  </section>

  <section id="clases" class="yoga-rhythm">
    <div class="yoga-rhythm-copy">
      <h2>{yogaCopy.classesTitle}</h2>
      <div class="class-accordion">
        {/* Each style is its own heading and its own anchor, so /yoga/#yin-yoga
            lands on it and an outline of the page lists the five styles. The
            h3 inherits the summary's type, so nothing moves.

            The shared name makes the five one group, so opening a style
            closes the one that was open and a single photo shows at a time.
            Every style starts closed, so the photo column opens on the
            default class photo beside it. */}
        {yogaCopy.classes.map((item) => (
          <details class="class-item" id={item.id} name="yoga-class">
            <summary><h3>{item.title}</h3></summary>
            {(Array.isArray(item.body) ? item.body : [item.body]).map((para) => (
              <p>{para}</p>
            ))}
            <img class="class-photo" src={item.image.src} alt={item.imageAlt} loading="lazy" />
          </details>
        ))}
      </div>
    </div>
    {/* What the photo column shows when every style is closed. An open
        style's own photo is laid over it. */}
    <div class="yoga-photo-stack">
      <img src={images.groupClass.src} alt="Clase grupal de yoga en Adarsha Yoga, Barcelona" />
    </div>
    <div class="yoga-rhythm-cta">
      <a class="btn-outline" href={yogaCopy.classesCtaHref}>{yogaCopy.classesCta}</a>
    </div>
  </section>

  <section id="precios" class="yoga-prices-band">
    <div class="container yoga-prices">
      <h2 class="prices-heading">{yogaCopy.pricesHeading}</h2>
      <div class="price-columns">
        {yogaCopy.prices.map((group) => (
          <div class="price-column">
            <h3>{group.title}</h3>
            <ul class="plain-lines">{group.items.map((item) => <li>- {item}</li>)}</ul>
          </div>
        ))}
      </div>
      <p class="prices-cta"><a class="btn-outline" href={externalLinks.momoyogaBuy} target="_blank" rel="noopener noreferrer">{yogaCopy.pricesCta}</a></p>
    </div>
  </section>

  {/* Laid out like the practice section above: the photo fills the left half
      of the page edge to edge, the list sits in the right half. */}
  <section id="mensualidad" class="membership-section">
    <img src={images.yogaMembership.src} alt="Práctica de yoga en la sala de Adarsha Yoga, Barcelona" loading="lazy" />
    <div class="membership-inner">
      <h2>{yogaCopy.membershipTitle}</h2>
      <ul class="membership-list">
        {yogaCopy.membership.map((item) => <li><strong>{item.title}:</strong> {item.body}</li>)}
      </ul>
    </div>
  </section>

  {/* #individuales and #empresas were full sections, which moved to pages of
      their own. The ids stay for links already pointing at them. */}
  <section id="individuales" class="page-teaser page-teaser-plain">
    <h2>{yogaCopy.individualTeaserTitle}</h2>
    <p>{yogaCopy.individualTeaser}</p>
    <a class="btn-outline" href={yogaCopy.individualTeaserHref}>{yogaCopy.individualTeaserCta}</a>
  </section>

  <section id="empresas" class="page-teaser">
    <h2>{yogaCopy.officeTeaserTitle}</h2>
    <p>{yogaCopy.officeTeaser}</p>
    <a class="btn-outline" href={yogaCopy.officeTeaserHref}>{yogaCopy.officeTeaserCta}</a>
  </section>
  <!-- A fragment link to a closed <details> scrolls to a shut drawer, so open
       the one that was asked for. Runs on load and on every later hash change,
       since the five styles link to each other within the page. -->
  <script is:inline>
    (() => {
      const open = () => {
        if (!location.hash) return;
        let item = null;
        try { item = document.querySelector(location.hash); } catch {}
        if (item instanceof HTMLDetailsElement) {
          item.open = true;
          item.scrollIntoView({ block: "start" });
        }
      };
      open();
      addEventListener("hashchange", open);
    })();
  </script>
</BaseLayout>
