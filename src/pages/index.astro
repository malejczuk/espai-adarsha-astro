---
import BaseLayout from "../layouts/BaseLayout.astro";
import { homeCopy, images } from "../content/site";

const titleMatch = homeCopy.title.match(/^(.+?[.!?])\s+(.+)$/);
---

<BaseLayout>
  <section class="home-intro">
    <div class="home-intro-copy">
      <h1>
        {/* The span is display: block, so the two halves already sit on
            separate lines. Without the space between them, though, the H1's
            text content reads "Adarsha Yoga.Un refugio" to a search engine
            and to a screen reader. */}
        {titleMatch ? <><span>{titleMatch[1]}</span>{" "}{titleMatch[2]}</> : homeCopy.title}
      </h1>
      <div class="home-intro-lead">
        <p>{homeCopy.subtitle}</p>
        {homeCopy.body.map((item) => <p>{item}</p>)}
      </div>
      <div class="home-cta-group">
        <a class="btn-outline" href={homeCopy.scheduleHref}>{homeCopy.scheduleCta}</a>
        <a class="btn-outline" href={homeCopy.reservaHref}>{homeCopy.reservaCta}</a>
      </div>
    </div>
    <img class="home-intro-image" src={images.homeHero.src} alt="Práctica de yoga en Adarsha Yoga" />
  </section>

  <section class="practice-heading">
    <h2>{homeCopy.practiceHeading}</h2>
  </section>
  <section class="practice-cards">
    {homeCopy.practiceOptions.map((option) => (
      <article class="practice-card">
        <img src={option.image.src} alt={option.alt} />
        <div class="practice-card-content">
          <h3>{option.title}</h3>
          <p>{option.body}</p>
          <a class="btn-outline" href={option.href}>{option.cta}</a>
        </div>
      </article>
    ))}
  </section>

  <section class="also-band">
    <img src={images.homeEcosystem.src} alt="Movimiento y conciencia pélvica" />
    <div class="also-copy">
      <h2>{homeCopy.alsoTitle}</h2>
      {homeCopy.alsoBody.map((item) => <p>{item}</p>)}
      <a class="btn-outline" href={homeCopy.alsoHref}>{homeCopy.alsoCta}</a>
    </div>
  </section>
</BaseLayout>
